# SQLite & Temporary Index (chỉ mục dẫn xuất cục bộ, tự động rebuild)
data/index/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Backup queue cục bộ
data/backup-queue/*
!data/backup-queue/.gitkeep

# Evidence: Cho phép theo dõi & đồng bộ hình ảnh minh chứng kỹ thuật qua Git
# data/evidence/ được push đầy đủ để các máy khác xem được ảnh
!data/evidence/
!data/evidence/*

# Python cache & environment
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
ENV/

# IDE & OS files
.vscode/
.idea/
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Secrets & Environment
.env
*.pem
*.key
*.token
